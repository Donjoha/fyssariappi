import { useState } from "react";

export default function ChatPage() {
  const [messages, setMessages] = useState([
    { from: "Anna", text: "Hyvin menee, jatka samaan malliin!" },
    { from: "Sinä", text: "Miten voisin parantaa liikettä?" },
    { from: "Anna", text: "Kokeile nostaa polvea hieman korkeammalle." }
  ]);

  const [input, setInput] = useState("");

  const sendMessage = () => {
    if (!input) return;
    setMessages([...messages, { from: "Sinä", text: input }]);
    setInput("");
  };

  return (
    <div className="container">
      <h2>Viestit</h2>

      <div className="card">
        {messages.map((m, i) => (
          <p key={i}><strong>{m.from}:</strong> {m.text}</p>
        ))}
      </div>

      <input
        style={{ width: "100%", padding: "12px", marginTop: "10px" }}
        value={input}
        onChange={(e) => setInput(e.target.value)}
        placeholder="Kirjoita viesti..."
      />

      <button onClick={sendMessage} style={{ marginTop: "10px" }}>
        Lähetä
      </button>
    </div>
  );
}
