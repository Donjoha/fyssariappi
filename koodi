export default function Slider({ label, value, setValue }) {
  return (
    <div className="card">
      <h4>{label}</h4>
      <input
        type="range"
        min="0"
        max="10"
        value={value}
        onChange={(e) => setValue(e.target.value)}
      />
      <p>Taso: {value}</p>
    </div>
  );
}
